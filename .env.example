# Meridian Academy deployment settings
#
# Vercel project (Production and Preview):
#   MERIDIAN_API_ORIGIN=https://your-api-host.example.com
#
# API host (Render/Railway/Fly/VPS or the bundled Docker image):
#   everything below.
#
# Local development needs none of this; `npm run setup` uses storage/.

# --- Vercel only ------------------------------------------------------------
# Public origin of the persistent PHP API. No trailing slash and no /api path.
MERIDIAN_API_ORIGIN=https://meridian-academy-api.onrender.com

# --- API host ---------------------------------------------------------------
MERIDIAN_ENV=production
MERIDIAN_DB_PATH=/data/meridian.sqlite
MERIDIAN_STORAGE_PATH=/data/storage

# The public site is HTTPS, so the session cookie must be Secure.
MERIDIAN_SECURE_COOKIES=1

# Trust X-Forwarded-For / X-Real-IP from the platform proxy. This keeps the
# sign-in rate limiter keyed per client instead of per proxy. Enable only when
# the container is not reachable directly.
MERIDIAN_TRUST_PROXY=1

# Do not seed the demonstration school in production.
MERIDIAN_SEED_DEMO=0

# Apply pending migrations and seeders when the container starts.
MERIDIAN_AUTO_MIGRATE=1

# Temporary Super Admin password; a change is forced on first sign-in.
MERIDIAN_ADMIN_EMAIL=admin@your-school.edu.af
MERIDIAN_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
