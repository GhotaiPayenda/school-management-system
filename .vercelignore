# Vercel hosts the built SPA only. The PHP API, SQLite database, migrations,
# seeders, tests, and local tooling are deployed to a persistent host instead.
#
# Directory patterns are anchored with a leading slash. Without it, a pattern
# such as "api/" also matches nested directories like web/src/api/ and breaks
# the SPA build.
/api/
/database/
/scripts/
/tests/
/storage/
/docs/
/.scratch/
/test-results/
/web/dist/
/web/node_modules/
/web/e2e/
/web/playwright-report/
/web/test-results/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
.env
.env.*
