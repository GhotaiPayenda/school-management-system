# Keep the build context small. Patterns that refer to top-level directories are
# anchored so they cannot exclude nested source such as web/src/api/.
.git
.gitignore
.gitattributes
.vercel
.vercelignore
node_modules
web/node_modules
/web/dist
/web/playwright-report
/web/test-results
/web/e2e
/test-results
/playwright-report
/storage
/tests
/.scratch
/docs
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
.env
.env.*
/README.md
